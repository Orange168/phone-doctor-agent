# oneplus-phone-mcp 环境配置示例
# 复制为 .env 或 export 到 shell 环境

# 设备序列号（一加 PGP110）
ONEPLUS_SERIAL=3902f377

# adb 路径（prebuilts v41）
ADB_PATH=/home/master/sourceCode/rk_356x_a12/code/prebuilts/runtime/adb

# scrcpy 路径
SCRCPY_PATH=/usr/local/bin/scrcpy

# 输出目录（截图/录制），默认 ./output
# ONEPLUS_OUTPUT=/path/to/output
